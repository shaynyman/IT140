  <diagram name="README" id="paycheck-readme-page">
    <mxGraphModel dx="668" dy="1708" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="README-title" value="&lt;h2&gt;How to Use This Flowchart Template&lt;/h2&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;" parent="1" vertex="1">
          <mxGeometry x="160" y="30" width="530" height="70" as="geometry" />
        </mxCell>
        <mxCell id="6f2VVitwZKotqvGw0nvI-1" value="&lt;b&gt;1. Read the Module Three Assignment Guidelines and Rubric first.&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;2. Complete Analyze before designing.&lt;/b&gt; Make sure you understand the input, pay rules, 40-hour boundary, decision, and output.&lt;br&gt;&lt;br&gt;&lt;b&gt;3. Build the graded chart on the Paycheck Calculator tab.&lt;/b&gt; Do not submit the README, Symbols, Snippets, or References tabs separately; they remain inside this .drawio file as reference pages.&lt;br&gt;&lt;br&gt;&lt;b&gt;4. Use appropriate symbols and arrows.&lt;/b&gt; The official assignment specifically calls for Start/End, Input/Output, Decision, and Processing symbols.&lt;br&gt;&lt;br&gt;&lt;b&gt;5. Check every path.&lt;/b&gt; Trace a regular-hours case, exactly 40 hours, an overtime case, and the 60-hour assignment example. Every path should reach the required output and End.&lt;br&gt;&lt;br&gt;&lt;b&gt;6. Compare with your pseudocode.&lt;/b&gt; Both graded artifacts should describe the same planned program.&lt;br&gt;&lt;br&gt;&lt;b&gt;7. Keep the file in .drawio format.&lt;/b&gt; Save frequently. Do not export an image or PDF as a replacement for the required .drawio submission." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;strokeWidth=1;spacing=14;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="100" y="120" width="650" height="500" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
